+mod profiling {
+    use std::{cell::Cell, time::Instant};
+    thread_local! {
+        static VALUES: Cell<[u64; 8]> = const { Cell::new([0; 8]) };
+    }
+    pub struct Guard(usize, Instant);
+    impl Guard {
+        pub fn new(index: usize) -> Self { Self(index, Instant::now()) }
+    }
+    impl Drop for Guard {
+        fn drop(&mut self) {
+            let ns = self.1.elapsed().as_nanos() as u64;
+            VALUES.with(|values| {
+                let mut v = values.get();
+                v[self.0] += ns;
+                values.set(v);
+            });
+        }
+    }
+    pub struct Report(usize);
+    impl Report {
+        pub fn new(thread: usize) -> Self {
+            VALUES.with(|v| v.set([0; 8]));
+            Self(thread)
+        }
+    }
+    impl Drop for Report {
+        fn drop(&mut self) {
+            VALUES.with(|v| eprintln!("profile_thread,{},{}", self.0,
+                v.get().map(|n| n.to_string()).join(",")));
+        }
+    }
